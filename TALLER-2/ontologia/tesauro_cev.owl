  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase definida: Hechos victimizantes AND (generaImpacto SOME Impactos)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#AfrontamientoAsociadoAHecho">
  <rdfs:subClassOf rdf:resource="#Afrontamientos_resistencias_no_violentas"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Afrontamientos_resistencias_no_violentas"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#respondeA"/>
          <owl:someValuesFrom rdf:resource="#Hechos_victimizantes"/>
