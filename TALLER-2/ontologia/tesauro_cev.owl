<?xml version="1.0"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
         xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
         xmlns:owl="http://www.w3.org/2002/07/owl#"
         xml:base="http://www.semanticweb.org/cev/tesauro"
         xmlns="http://www.semanticweb.org/cev/tesauro#">

<owl:Ontology rdf:about="http://www.semanticweb.org/cev/tesauro"/>

<owl:ObjectProperty rdf:about="#esParteDe">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#parteDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es parte de</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Meronimia del tesauro: el concepto hijo es parte del concepto padre. Se declara por axioma de clase para cada edge de la jerarquia.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#parteDe">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esParteDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">parte de</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:esParteDe.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#relacionadoCon">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">relacionado con</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Termino relacionado (TR) del tesauro: afinidad terminologica entre conceptos de grupos distintos. Simetrica. Ver criterio en relaciones_afines.txt.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#perpetradoPor">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esVictimaDe"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">perpetrado por</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Vinculo hecho victimizante - actor armado por co-ocurrencia terminologica especifica en el marco del conflicto (criterio en relaciones_afines.txt).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esVictimaDe">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#perpetradoPor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es victima de</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:perpetradoPor.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#afectaA">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esAfectadaPor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">afecta a</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Un hecho victimizante afecta a una poblacion (modelo del ciclo del conflicto).</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esAfectadaPor">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#afectaA"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es afectada por</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:afectaA.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#generaImpacto">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esGeneradoPor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">genera impacto</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Un hecho victimizante genera impactos en poblaciones y territorios.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esGeneradoPor">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#generaImpacto"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es generado por</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:generaImpacto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#experimentaImpacto">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#impactaA"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">experimenta impacto</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Una poblacion experimenta los impactos del conflicto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#impactaA">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#experimentaImpacto"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">impacta a</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:experimentaImpacto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#desarrollaAfrontamiento">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esDesarrolladoPor"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">desarrolla afrontamiento</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Una poblacion desarrolla afrontamientos y resistencias no violentas.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esDesarrolladoPor">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#desarrollaAfrontamiento"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es desarrollado por</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:desarrollaAfrontamiento.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#respondeA">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esRespondidoMediante"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">responde a</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Un afrontamiento o resistencia responde a un hecho victimizante o un impacto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esRespondidoMediante">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#respondeA"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es respondido mediante</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:respondeA.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#empleaArma">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#esEmpleadaEn"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">emplea arma</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Un actor armado emplea armas en el conflicto.</rdfs:comment>
</owl:ObjectProperty>

<owl:ObjectProperty rdf:about="#esEmpleadaEn">
  <rdfs:domain rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:range rdf:resource="#ConceptoDelTesauro"/>
  <owl:inverseOf rdf:resource="#empleaArma"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">es empleada en</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Propiedad inversa de cev:empleaArma.</rdfs:comment>
</owl:ObjectProperty>

<owl:AnnotationProperty rdf:about="#grupo">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">grupo raiz</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Grupo raiz del tesauro al que pertenece el concepto.</rdfs:comment>
</owl:AnnotationProperty>

<owl:AnnotationProperty rdf:about="#eje">
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">eje conceptual</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Eje conceptual del grupo (filtro de seleccion).</rdfs:comment>
</owl:AnnotationProperty>

<owl:Class rdf:about="#ConceptoDelTesauro">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Concepto del tesauro de la Comision de la Verdad</rdfs:label>
</owl:Class>

<owl:Class rdf:about="#Actores_armados">
  <rdfs:subClassOf rdf:resource="#ConceptoDelTesauro"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#empleaArma"/>
      <owl:someValuesFrom rdf:resource="#Armas"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra</rdfs:comment>
  <grupo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra</grupo>
  <eje rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentes</eje>
</owl:Class>

<owl:Class rdf:about="#AccionarDeLosActoresArmados">
  <rdfs:subClassOf rdf:resource="#Actores_armados"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#esParteDe"/>
      <owl:someValuesFrom rdf:resource="#Actores_armados"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accionar de los actores armados</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra - Accionar de los actores armados</rdfs:comment>
  <grupo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra</grupo>
  <eje rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentes</eje>
</owl:Class>

<owl:Class rdf:about="#AccionesBelicas">
  <rdfs:subClassOf rdf:resource="#AccionarDeLosActoresArmados"/>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#esParteDe"/>
      <owl:someValuesFrom rdf:resource="#AccionarDeLosActoresArmados"/>
    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:subClassOf>
    <owl:Restriction>
      <owl:onProperty rdf:resource="#relacionadoCon"/>
