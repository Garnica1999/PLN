    </owl:Restriction>
  </rdfs:subClassOf>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Acciones bélicas</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra - Accionar de los actores armados - Acciones bélicas</rdfs:comment>
  <grupo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Actores armados y otros participantes en las dinámicas de la guerra</grupo>
  <eje rdf:datatype="http://www.w3.org/2001/XMLSchema#string">agentes</eje>
</owl:Class>

