<owl:Class rdf:about="#HechoPerpetradoPorActor">
  <rdfs:subClassOf rdf:resource="#Hechos_victimizantes"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Hechos_victimizantes"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#perpetradoPor"/>
          <owl:someValuesFrom rdf:resource="#Actores_armados"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HechoPerpetradoPorActor</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase definida: Hechos victimizantes AND (perpetradoPor SOME Actores armados)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PoblacionAfectadaPorHechos">
  <rdfs:subClassOf rdf:resource="#Poblaciones"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Poblaciones"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#esAfectadaPor"/>
          <owl:someValuesFrom rdf:resource="#Hechos_victimizantes"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoblacionAfectadaPorHechos</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase definida: Poblaciones AND (esAfectadaPor SOME Hechos victimizantes)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PoblacionConImpacto">
  <rdfs:subClassOf rdf:resource="#Poblaciones"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Poblaciones"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#experimentaImpacto"/>
          <owl:someValuesFrom rdf:resource="#Impactos"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoblacionConImpacto</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase definida: Poblaciones AND (experimentaImpacto SOME Impactos)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PoblacionConAfrontamiento">
  <rdfs:subClassOf rdf:resource="#Poblaciones"/>
  <owl:equivalentClass>
    <owl:Class>
      <owl:intersectionOf rdf:parseType="Collection">
        <rdf:Description rdf:about="#Poblaciones"/>
        <owl:Restriction>
          <owl:onProperty rdf:resource="#desarrollaAfrontamiento"/>
          <owl:someValuesFrom rdf:resource="#Afrontamientos_resistencias_no_violentas"/>
        </owl:Restriction>
      </owl:intersectionOf>
    </owl:Class>
  </owl:equivalentClass>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">PoblacionConAfrontamiento</rdfs:label>
  <rdfs:comment rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Clase definida: Poblaciones AND (desarrollaAfrontamiento SOME Afrontamientos resistencias no violentas)</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#HechoQueGeneraImpacto">
  <rdfs:subClassOf rdf:resource="#Hechos_victimizantes"/>
  <owl:equivalentClass>
