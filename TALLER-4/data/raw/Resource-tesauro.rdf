kos:prefLabel xml:lang="es">Sindicato de Trabajadores Agrícolas Independientes del Meta - SINTRAGRIM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-12-10 14:51:21</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27171"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores Agropecuarios del Municipio de Morales Departamento del Cauca</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-12-10 14:34:08</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25765"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores Campesinos del Cordón Fronterizo del Putumayo - SINTCACFROMAYO</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-11-05 14:48:34</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25751"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores de Cemento Argos S.A.S - SINTRACEARGOS</skos:prefLabel><skos:altLabel xml:lang="es">Sindicato de Trabajadores de Cementos El Cairo - SINTRACAIRO</skos:altLabel> <skos:historyNote xml:lang="es">Con la creación en 1946 de Cementos El Cairo, surgió el Sindicato de Trabajadores de Cementos El Cairo - SINTRACAIRO. Posteriormente, con la fusión de todas las compañias cementeras de Colombia bajo el nombre de Cementos Argos, se dio paso al Sindicato de Trabajadores de Cemento Argos S.A.S - SINTRACEARGOS (Múnera, 2009, p. 109).</skos:historyNote> <skos:note xml:lang="es">Múnera, P. (2009). El diálogo social en la construcción de la convención colectiva única en Cementos Argos [Tesis de pregrado, Universidad Eafit]. https://repository.eafit.edu.co/bitstream/handle/10784/220/PabloAntonio_MuneraUribe_2009.pdf;jsessionid=2E4D78BA38ECFADCBD28CB2A82411277?sequence=1 </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-11-05 14:48:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25787"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores de Cementos del Nare S.A. - SINTRACENARE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-11-05 15:14:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25817"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores de Cementos del Valle - SINTRACEMENTOS DEL VALLE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-11-05 15:14:02</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25798"><skos:prefLabel xml:lang="es">Sindicato de Trabajadores de Clínicas y Hospitales del Valle del Cauca - SINTRAHOSPICLINICAS</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-11-05 15:14:01</dct:c