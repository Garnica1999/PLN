cheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"><skos:prefLabel xml:lang="es">Núcleo 1. Democracia y conflicto armado</skos:prefLabel> <skos:note xml:lang="es">Centro Nacional de Memoria Histórica. (2013). ¡Basta ya! Colombia: Memorias de guerra y dignidad. Informe General Grupo de Memoria Histórica. Imprenta Nacional. http://www.centrodememoriahistorica.gov.co/descargas/informes2013/bastaYa/basta-ya-colombia-memorias-de-guerra-y-dignidad-2016.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=39"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=38"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=40"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=43"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=44"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=42"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=29"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=41"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=37"/>  <dct:created>2020-02-25 15:04:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=45"><skos:prefLabel xml:lang="es">Núcleo 2. El Estado y sus responsabilidades en el conflicto armado</skos:prefLabel> <skos:note xml:lang="es">Adaptado de: Sanabria Rodelo, Alejandro. (2018). La responsabilidad del Estado por la corrupción en el conflicto armado colombiano. http://prometheo.pe/la-responsabilidad-del-estado-por-la-corrupcion-en-el-conflicto-armado-colombiano/ (Consultado el 18 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3301"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=48"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=50"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=46"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=49"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=47"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=51"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=52"/>  <dct:created>2020-02-25 15:41:39</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=63"><skos:prefLabel xml:lang="es">Núcleo 3. Actores armados y otros participantes en las dinámicas de la guerra</skos:prefLabel> <skos:note xml:lang="es">1. Oficina de Naciones Unidas para la Coordinación de Asuntos Humanitarios - OCHA. Actor armado. https://wiki.salahumanitaria.co/wiki/Actor_armado  
(Consultado el 15 de diciembre de 2020).
2. Oficina de Naciones Unidas para la Coordinación de Asuntos Humanitarios - OCHA. (2013). Conflicto en Colombia: antecedentes históricos y actores. https://www.cidob.org/publicaciones/documentacion/dossiers/dossier_proceso_de_paz_en_colombia/dossier_proceso_de_paz_en_colombia/conflicto_en_colombia_antecedentes_historicos_y_actores (Consultado el 15 de diciembre de 2020).
</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=75"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=70"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=76"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=66"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3298"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=65"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=72"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=69"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=67"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3302"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=64"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=74"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=73"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=68"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=71"/>  <dct:created>2020-02-25 15:46:15</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=114"><skos:prefLabel xml:lang="es">Núcleo 4.1. Economía y modelos de desarrollo y conflicto armado interno</skos:prefLabel> <skos:note xml:lang="es">1. Basado en: Renjifo, C., Salazar, A., Otoya, A. L., y Echeverry D. (s.f.). Modelos de desarrollo en Colombia (cuadro sinóptico). https://es.slideshare.net/beta1108/modelos-de-desarrollo-en-colombia (Consultado el 16 de diciembre de 2020). 
2. Mantilla Valbuena, Silvia. (2012). Economía y conflicto armado en Colombia: los efectos de la globalización en la transformación de la guerra. Latinoamérica. Revista de estudios Latinoamericanos, 55, 35-73. http://www.scielo.org.mx/scielo.php?script=sci_arttext&amp;pid=S1665-85742012000200003&amp;lng=es&amp;tlng=es (Consultado el 21 de diciembre de 2020).
3. Dinero. (14 de octubre 2014). ¿Qué le pasa a la economía de un país en conflicto? https://www.dinero.com/pais/articulo/costos-economicos-del-conflicto-armado-colombia/202052 (Consultado el 21 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=117"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=118"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=116"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=120"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=115"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=122"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=119"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=121"/>  <dct:created>2020-02-25 16:03:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=138"><skos:prefLabel xml:lang="es">Núcleo 4.2. Despojo de tierras y desplazamiento forzado</skos:prefLabel> <skos:note xml:lang="es">Consultoría para los Derechos Humanos y el desplazamiento (CODHES). (2016). Informe sobre los procesos de desplazamiento, despojo y restitución de tierras en el predio El Toco, departamento de Cesar. http://www.codhes.org/~codhes/images/DOCUMENTOS-DE-INTERES/Informe_El_Toco_CODHES.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=139"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=140"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=147"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=141"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=142"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=145"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=146"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=143"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=144"/>  <dct:created>2020-02-25 16:10:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=158"><skos:prefLabel xml:lang="es">Núcleo 5. Narcotráfico y conflicto armado</skos:prefLabel> <skos:note xml:lang="es">Peco Yeste, M. y Peral Fernández L. (2005). El fenómeno del narcotráfico. En El Conflicto de Colombia. (p.27 y 28). https://core.ac.uk/download/pdf/29404428.pdf (Consultado el 15 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=162"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=159"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=161"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=163"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=164"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=160"/>  <dct:created>2020-02-25 16:16:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=181"><skos:prefLabel xml:lang="es">Núcleo 7. Causas, dinámicas e impactos del conflicto armado sobre los pueblos y territorios étnicos</skos:prefLabel> <skos:note xml:lang="es">Pardo, A. (2005). Los pueblos indígenas y sus derechos de cara al conflicto armado: ¿Retórica o realidad latente y manifiesta?. Trabajo Social, (7), 125 - 139. https://revistas.unal.edu.co/index.php/tsocial/article/view/8480 </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=183"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=190"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=184"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=198"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=185"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=186"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=196"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=195"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=197"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=192"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=189"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=193"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=182"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=191"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=194"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=188"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=187"/>  <dct:created>2020-02-26 10:55:34</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3296"><skos:prefLabel xml:lang="es">Núcleo 8.1. Exilio como consecuencia del conflicto armado</skos:prefLabel> <skos:note xml:lang="es">1. Alto Comisionado de las Naciones Unidas para los Refugiados - ACNUR (s.f.). Exilio y destierro, ¿qué significan? https://eacnur.org/es/exilio-y-destierro-que-significan (Consultado el 15 de diciembre de 2020).
2. Centro Nacional de Memoria Histórica. (2018). Exilio colombiano. Huellas del conflicto armado más allá de las fronteras. Bogotá: CNMH. p. 41. http://centrodememoriahistorica.gov.co/wp-content/uploads/2020/01/exilio-colombiano-huellas-del-conflicto-armado_v2.pdf (Consultado el 16 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=242"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=241"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=237"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=235"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=245"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=243"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19776"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19777"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=244"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=240"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=246"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=236"/>  <dct:created>2020-04-24 11:03:09</dct:created><dct:modified>2020-12-04 10:07:13</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=282"><skos:prefLabel xml:lang="es">Núcleo 8.2. Dimensiones internacionales del conflicto</skos:prefLabel> <skos:note xml:lang="es">Bitar, G. (2007). Dimensiones internacionales de los conflictos armados internos. Perspectivas