="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3093"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3364"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3362"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3363"/>  <dct:created>2020-04-27 07:58:26</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=303"><skos:prefLabel xml:lang="es">Escuelas de formación de paramédicos/enfermeros</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=295"/>  <dct:created>2020-02-26 11:45:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27529"><skos:prefLabel xml:lang="es">Escuelas de Perdón y Reconciliación - ESPERE</skos:prefLabel> <skos:note xml:lang="es">Adaptado de: Fundación para la Reconciliación. (s.f.). Escuelas de Perdon y Reconciliacipon (ESPERE). http://fundacionparalareconciliacion.org/escuelas-de-perdon-y-reconciliacion-espere/ (Consultado el 9 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-18 11:08:23</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27530"><skos:prefLabel xml:lang="es">Escuelas Radiofónicas</skos:prefLabel> <skos:historyNote xml:lang="es">Programa de educación al campesinado a través de la cadena radial, Radio Sutenza, el cual fue desarrollado por la Acción Cultural Popular - ACPO de la mano del sacerdote José Joaquín Salcedo.</skos:historyNote> <skos:note xml:lang="es">Morad. G. (2017). Radio Sutatenza: la primera revolución educativa del campo para el campo. https://www.radionacional.co/noticia/campesinos/radio-sutatenza-la-primera-revolucion-educativa-del-campo-campo (Consultado el 18 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-18 11:19:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26233"><skos:prefLabel xml:lang="es">Escultor de madera</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:30:08</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26234"><skos:prefLabel xml:lang="es">Esmeraldero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:30:08</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25009"><skos:prefLabel xml:lang="es">Espacio Colectivo y Consultivo de Comunidades Negras de Palmira - URAMBA</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:35:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27119"><skos:prefLabel xml:lang="es">Espacio de Trabajadores y Trabajadoras de Derechos Humanos - ETTDDHH</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-10 09:56:19</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25010"><skos:prefLabel xml:lang="es">Espacio Regional de Construcción de Paz de los Montes de María</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:35:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27317"><skos:prefLabel xml:lang="es">Espacio Regional de paz del Cauca - ERPAZ</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-17 15:16:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27528"><skos:prefLabel xml:lang="es">Espacios Territoriales de Capacitación y Reincorporación - ETCR</skos:prefLabel> <skos:note xml:lang="es">ARN. (s.f.). Espacios Territoriales de Capacitación y Reincorporación (ETCR). http://www.reincorporacion.gov.co/es/reincorporacion/Paginas/Los-ETCR.aspx (Consultado el 07 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-18 11:00:39</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tem