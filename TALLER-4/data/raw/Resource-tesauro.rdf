  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21699"><skos:prefLabel xml:lang="es">Escuadra</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21691"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21719"/>  <dct:created>2020-07-03 10:14:02</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21725"><skos:prefLabel xml:lang="es">Escuadra suboficiales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21720"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21734"/>  <dct:created>2020-07-06 13:12:51</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27114"><skos:prefLabel xml:lang="es">Escuela Audiovisual Infantil de Belén de los Andaquíes - EAI</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-10 09:40:05</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25893"><skos:prefLabel xml:lang="es">Escuela de Caballería - ESCAB</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3340"/>  <dct:created>2020-11-11 16:11:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3387"><skos:prefLabel xml:lang="es">Escuela de Formación de Infantería de Marina</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3379"/>  <dct:created>2020-04-27 08:12:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27115"><skos:prefLabel xml:lang="es">Escuela de Formación Jóvenes Constructores de Paz</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 09:41:59</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25926"><skos:prefLabel xml:lang="es">Escuela de las Américas</skos:prefLabel> <skos:historyNote xml:lang="es">Organización del Ejército de los Estados Unidos de Amércia dedicada a la instrucción militar, fundada en 1946 en Panamá y en 1984 traslada al Fuerte Benning, estado de Georgia en Estados Unidos. Funcionó hasta el año 2000, y tras su cierre se creó en el 2001 el Instituto del Hemisferio Occidental para la Cooperación en Seguridad (Western Hemisphere Institute for Security Cooperation – WHINSEC), ahora adscrito al departamento de Defensa de este país y no al Ejército por solicitud de la Organización de los Estados Americanos - OEA. Varias miembros de las Fuerzas Militares de Colombia recibieron entrenamiento en esta organización.</skos:historyNote> <skos:note xml:lang="es">Adaptado de: Colección Fuentes de archivo externo: Proyecto de Documentación Colombia - National Security Archive; Ampliaciones versiones colectivas Caso 001 - JEP; Documentos de contexto entregados a la JEP para el caso 001 - Partido FARC.</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-11-12 10:31:48</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3364"><skos:prefLabel xml:lang="es">Escuela de Posgrados Fuerza Aérea Colombiana - EPFAC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3358"/>  <dct:created>2020-04-27 08:02:19</dct:created><dct:modified>2020-09-09 16:58:11</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27101"><skos:prefLabel xml:lang="es">Escuela de Sistematización de Conocimientos Locales - Experiencias Vivas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-10 08:57:25</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3385"><skos:prefLabel xml:lang="es">Escuela de Suboficiales de Barranquilla</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3379"/>  <dct:created>2020-04-27 08:12:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25007"><skos:prefLabel xml:lang="es">Escuela Feminista Guadalupe Zapata</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:35:03</dct:created>  </skos:Concept>  <skos:Concept rdf: