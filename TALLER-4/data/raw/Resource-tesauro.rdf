http://www.aliat.org.mx/BibliotecasDigitales/comunicacion/Medios_de_comunicacion_masiva.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=829"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=828"/>  <dct:created>2020-04-22 08:51:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=141"><skos:prefLabel xml:lang="es">Medios utilizados para el despojo</skos:prefLabel> <skos:note xml:lang="es">Congreso de la República. (2011). Ley 1448 de 2011: por la cual se dictan medidas de atención, asistencia y reparación integral a las víctimas del conflicto armado interno y se dictan otras disposiciones. Diario Oficial, 10 de junio de 2011, n.º 48.096. Bogotá, D. C.: Imprenta Nacional de Colombia.</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=138"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=156"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=155"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=157"/>  <dct:created>2020-02-25 16:11:36</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=169"><skos:prefLabel xml:lang="es">Medios y dinámicas de transporte</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=160"/>  <dct:created>2020-02-25 16:20:18</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=115"><skos:prefLabel xml:lang="es">Megaproyectos</skos:prefLabel> <skos:scopeNote xml:lang="es">Proyectos de gran envergadura y escala que responden a una estrategia de intervención económica y de ocupación territorial, en la que se ven involucrados una multiplicidad de actores públicos y privados, nacionales o internacionales (Ej.: megaproyectos de infraestructura, minero-energéticos y agroindustriales).</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=114"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=125"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=123"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=124"/>  <dct:created>2020-02-25 16:04:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2063"><skos:prefLabel xml:lang="es">Melodia Stereo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:52</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1510"><skos:prefLabel xml:lang="es">Melodia Stero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:49</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2481"><skos:prefLabel xml:l