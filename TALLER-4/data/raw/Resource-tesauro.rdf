d.co/tesauro/vocab/?tema=21811"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21813"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21812"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21810"/>  <dct:created>2020-07-08 10:56:23</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21678"><skos:prefLabel xml:lang="es">Suboficiales del Ejército Nacional de Colombia</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21676"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21720"/>  <dct:created>2020-07-03 10:01:38</dct:created><dct:modified>2020-10-22 16:00:22</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27103"><skos:prefLabel xml:lang="es">Subsecretaría de Derechos Humanos y Convivivencia Ciudadana de Itagüí</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=22565"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-12-10 08:59:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13640"><skos:prefLabel xml:lang="es">Subsecretario General</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13626"/>  <dct:created>2020-04-30 10:05:42</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21719"><skos:prefLabel xml:lang="es">Subteniente - ST</skos:prefLabel> <skos:scopeNote xml:lang="es">En Colombia, "subteniente (o teniente segundo) es el primer grado del oficial, al que ascienden los egresados de las distintas Escuelas Militares de Oficiales; del Ejército, Armada, Fuerza Aérea y la Policía Nacional, luego de 1 año de formación para quienes ostenten título profesional y 3 años para aquellos que ingresaron como bachilleres o con título de educación técnica o tecnológica después del grado de alférez". [Subteniente. (23 de julio de 2020). En Wikipedia. https://es.wikipedia.org/wiki/Subteniente]</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21699"/>  <dct:created>2020-07-06 13:11:18</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21808"><skos:prefLabel xml:lang="es">Subteniente de la Policía Nacional - ST</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21791"/>  <dct:created>2020-07-08 10:59:54</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21690"><skos:prefLabel xml:lang="es">Subteniente del Aire - ST</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21679"/>  <dct:created>2020-07-03 10:12:42</dct:created><dct:modified>2020-07-06 13:04:26</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2443"><skos:prefLabel xml:lang="es">Suin</skos:prefLabel><skos:inScheme rdf:resourc