esource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20852"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20853"/>  <dct:created>2020-07-02 13:32:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21925"><skos:prefLabel xml:lang="es">Departamento Nacional de Planeación - DNP</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-08-14 14:09:00</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20121"><skos:prefLabel xml:lang="es">Department of Defense of the United States - DOD</skos:prefLabel><skos:altLabel xml:lang="es">Departamento de Defensa de Estados Unidos - DOD</skos:altLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-06-10 11:03:20</dct:created><dct:modified>2020-06-23 10:14:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26180"><skos:prefLabel xml:lang="es">Deportista</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:25:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=198"><skos:prefLabel xml:lang="es">Derechos territoriales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=181"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=230"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=555"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=231"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=232"/>  <dct:created>2020-02-26 10:58:25</dct:created><dct:modified>2020-10-28 19:28:55</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3299"><skos:prefLabel xml:lang="es">Desactivación de minas explosivas</skos:prefLabel> <skos:note xml:lang="es">Consiste en un enfoque integrado que abarca diferentes actividades para localizar el emplazamiento de minas o su eliminación; o por lo menos, para reducir el peligro de sus daños potenciales. La detección y desactivación de minas son tareas bastante lentas, de alto riesgo físico y costosas. Si bien una mina puede adquirirse por unos pocos dólares, para la desactivación se emplean diferentes métodos, pero cada uno presenta inconvenientes. Así, uno de los más habituales consiste en el barrido del suelo con detectores de metales, pero esto no sirve para las minas fabricadas en plástico, al tiempo que suelen provocar cientos de falsas alarmas por cada artefacto detectado. Otro sistema se basa en el uso de perros, los cuales no pueden trabajar más de dos horas diarias. Recientemente, un instituto holandés ha presentado un nuevo sistema de detección, cofinanciado por la Unión Europea, basado en un sofisticado mecanismo de fotografías aéreas.</skos:note> <skos:note xml:lang="es">Basado en Minas Antipersonales. (s.f.). En Diccionario de Acción Humanitaria y Cooperación al Desarrollo http://www.dicc.hegoa.ehu.es/listar/mostrar/144 (Consultado el 20 de octubre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=492"/>  <dct:created>2020-04-24 11:42:10</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13729"><skos:prefLabel xml:lang="es">Desano</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13702"/>  <dct:created>2020-04-30 10:13:16</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25947"><skos:prefLabel xml:lang="es">Desaparecidos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21872"/>  <dct:created>2020-11-13 10:51:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=410"><skos:prefLabel xml:lang="es">Desaparición como medio de intimidación</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=368"/>  <dct:created>2020-02-26 15:20:29</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=409"><skos:prefLabel xml:lang="es">Desaparición encubridora</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=368"/>  <dct:created>2020-02-26 15:20:29</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=368"><skos:prefLabel xml:lang="es">Desaparición forzada</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=363"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=410"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=409"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=408"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=411"/>  <dct:created>2020-02-26 15:00:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=408"><skos:prefLabel xml:lang="es">Desaparición selectiva</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=368"/>  <dct:created>2020-02-26 15:20:29</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=66"><skos:prefLabel xml:lang="es">Desarme, desmovilización, desvinculación, reintegración/reincorporación</skos:prefLabel> <skos:scopeNote xml:lang="es">Esta categoría abarca los diversos procesos de paz y acuerdos establecidos durante la negociación entre los grupos armados y el estado, teniendo en cuenta los procesos de concentración, desarme y reintegración/reincorporación, así como los factores que conllevaron a la creación de grupos emergentes y disidencias.</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=63"/>  <dct:created>2020-02-25 15:47:44</dct:created><dct:modified>2020-09-09 17:55:38</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=279"><skos:prefLabel xml:lang="es">Desarraigo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=307"/>  <dct:created>2020-02-26 11:23:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=211"><skos:prefLabel xml:lang="es">Desarrollos institucionales étnicos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=191"/>  <dct:created>2020-02-26 11:00:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=504"><skos:prefLabel xml:lang="es">Desarrollos institucionales y políticas públicas agrarias</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=502"/>  <dct:created>2020-02-26 15:46:42</dct:created><dct:modified>2020-08-27 10:35:39</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=508"><skos:prefLabel xml:lang="es">Desarrollos institucionales y políticas públicas ambientales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=502"/>  <dct:created>2020-02-26 15:46:42</dct:created><dct:modified>2020-08-27 10:36:25</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=510"><skos:prefLabel xml:lang="es">Desarrollos institucionales y políticas públicas culturales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rd