tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:49</dct:created><dct:modified>2020-06-16 08:02:58</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2810"><skos:prefLabel xml:lang="es">Mañature</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:42</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1388"><skos:prefLabel xml:lang="es">Manaure Estéreo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:48</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26391"><skos:prefLabel xml:lang="es">Mandadero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 18:00:11</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24219"><skos:prefLabel xml:lang="es">Mandato 1. Prácticas y hechos que constituyen graves violaciones a los derechos humanos y graves infracciones al Derecho Internacional Humanitario (DIH)</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24228"><skos:prefLabel xml:lang="es">Mandato 10. El desplazamiento forzado y despojo de tierras con ocasión del conflicto y sus consecuencias</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24229"><skos:prefLabel xml:lang="es">Mandato 11. La relación entre el conflicto y los cultivos de uso ilícito</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24230"><skos:prefLabel xml:lang="es">Mandato 12. Los procesos de fortalecimiento del tejido social en las comunidades y las experiencias de resiliencia individual o colectiva</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24231"><skos:prefLabel xml:lang="es">Mandato 13. Los procesos de transformación positiva de las organizaciones e instituciones a lo largo del conflicto</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24220"><skos:prefLabel xml:lang="es">Mandato 2. Las responsabilidades colectivas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created><dct:modified>2020-10-16 10:35:40</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24221"><skos:prefLabel xml:lang="es">Mandato 3. El impacto humano y social del conflicto en la sociedad</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24222"><skos:prefLabel xml:lang="es">Mandato 4. El impacto del conflicto sobre el ejercicio de la política y el funcionamiento de la democracia en su conjunto</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24223"><skos:prefLabel xml:lang="es">Mandato 5. El impacto del conflicto sobre quienes participaron directamente en él</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24224"><skos:prefLabel xml:lang="es">Mandato 6. El contexto histórico; los orígenes y múltiples causas del conflicto</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24225"><skos:prefLabel xml:lang="es">Mandato 7. Los factores y condiciones que facilitaron o contribuyeron a la persistencia del conflicto</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24226"><skos:prefLabel xml:lang="es">Mandato 8. El desarrollo del conflicto</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24227"><skos:prefLabel xml:lang="es">Mandato 9. El fenómeno del paramilitarismo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"/>  <dct:created>2020-10-16 07:40:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27141"><skos:prefLabel xml:lang="es">Mandato Ciudadano por la Paz, la Vida y la Libertad</skos:prefLabel> <skos:note xml:lang="es">LATINNO. (s.f.). Mandato Ciudadano por la Paz, la Vida y la Libertad. https://latinno.net/es/case/5124/ (Consultado el 10 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 10:51:00</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27142"><skos:prefLabel xml:lang="es">Mandato de los Niños por la Paz</skos:prefLabel> <skos:note xml:lang="es">Adaptado de: Comisión de la Verdad. (2020). "No nos dejaban votar, pero lo hicimos para manifestarnos en favor de un país en paz". https://comisiondelaverdad.co/actualidad/noticias/mandato-ninos-ninas-paz-no-dejaban-votar-lo-hicimos-favor-pais-paz (Consultado el 10 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27150"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 10:59:48</dct:created><dct:modified>2020-12-10 11:34:39</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24204"><skos:prefLabel xml:lang="es">Mandatos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24203"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24219"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24228"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24229"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24230"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesau