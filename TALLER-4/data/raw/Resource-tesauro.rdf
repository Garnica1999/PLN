t>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1141"><skos:prefLabel xml:lang="es">Provincia Estéreo 101.6</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2611"><skos:prefLabel xml:lang="es">Provincial</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1930"><skos:prefLabel xml:lang="es">Proyección 2000 Stereo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:51</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1836"><skos:prefLabel xml:lang="es">Proyección Estéreo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:51</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27540"><skos:prefLabel xml:lang="es">Proyecto Barrio Antioquia de Paz - PROBAPAZ</skos:prefLabel> <skos:historyNote xml:lang="es">Organización creada en 1996 para coordinar el pacto de no agresión entre las bandas del barrio Antioquia (Medellín) y emprender programas educativos, recreativos y comunitarios con niños y jóvenes.</skos:historyNote> <skos:note xml:lang="es">Centro Nacional de Memoria Histórica. (2017). Medellín: memorias de una guerra urbana. Corporación Región, Ministerio del Interior, Alcaldía de Medellín, Universidad EAFIT, Universidad de Antioquia. http://centrodememoriahistorica.gov.co/descargas/medellin-memorias-de-una-guerra-urbana.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-18 14:40:38</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27549"><skos:prefLabel xml:lang="es">Proyecto Colombia Nunca Más - PCNM</skos:prefLabel> <skos:note xml:lang="es">Martínez, A. (2018). El surgimiento del MOVICE y la teoría contemporánea de los movimientos sociales. NOVUMJUS, 12(1), 131 - 161. https://novumjus.ucatolica.edu.co/article/view/1968 </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-19 11:04:25</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27183"><skos:prefLabel xml:lang="es">Proyecto de Vivienda Urbanización Enraizar</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 16:44:36</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27554"><skos:prefLabel xml:lang="es">Proyecto Javeriano de Paz y Reconciliación - PJPR</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-19 11:19:07</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27555"><skos:prefLabel xml:lang="es">Proyecto Nasa</skos:prefLabel> <skos:note xml:lang="es">USAID. (s.f.). Proyecto Nasa: Toribío crea su propio historia. http://bancadelasoportunidades.gov.co/es/articulos/micrositio/proyecto-nasa-toribio-crea-su-propio-historia (Consultado el 19 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-19 11:19:07</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25632"><skos:prefLabel xml:lang="es">Proyecto Rescatando Nuestras Raíces</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-11-04 16:59:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25633"><skos:prefLabel xml:lang="es">Proyecto Rincón de la Memoria</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-11-04 17:01:34</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27553"><skos:prefLabel xml:lang="es">Proyecto Team Colombia</skos:prefLabel> <skos:note xml:lang="es">UARIV. (16 de junio de 2017). Proyecto TEAM: Colombia beneficia a víctimas del conflicto en condición de discapacidad. 