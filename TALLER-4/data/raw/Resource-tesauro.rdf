0-04-22 10:00:17</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26692"><skos:prefLabel xml:lang="es">Tendero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 18:33:36</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21737"><skos:prefLabel xml:lang="es">Ténico Jefe - TJ</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21680"/>  <dct:created>2020-07-06 13:18:48</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21738"><skos:prefLabel xml:lang="es">Ténico Subjefe - TS</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21680"/>  <dct:created>2020-07-06 13:18:48</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21718"><skos:prefLabel xml:lang="es">Teniente - TE</skos:prefLabel> <skos:scopeNote xml:lang="es">"En las fuerzas militares colombianas (Ejército, Armada, Fuerza Aérea) y la Policía Nacional, teniente es el segundo grado de los oficiales, grado inmediatamente inferior al de Capitán e inmediatamente superior al de Subteniente". [Teniente. (23 de julio de 2020). En Wikipedia. https://es.wikipedia.org/wiki/Teniente]</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21698"/>  <dct:created>2020-07-06 13:10:56</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21715"><skos:prefLabel xml:lang="es">Teniente Coronel - TC</skos:prefLabel> <skos:scopeNote xml:lang="es">En Colombia, "segundo grado de los oficiales superiores de la Fuerzas Militares (Ejército, Armada y Fuerza Aérea y la Policía Nacional). [...] Grado inmediatamente superior al de mayor. Estatutariamente, el grado dura cinco años, antes de que el oficial pueda ser promovido al grado de coronel". [Teniente coronel. (23 de julio de 2020). En Wikipedia. https://es.wikipedia.org/wiki/Teniente_coronel]</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21696"/>  <dct:created>2020-07-06 13:09:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21804"><skos:prefLabel xml:lang="es">Teniente Coronel de la Policía Nacional - TC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21791"/>  <dct:created>2020-07-08 10:59:54</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21686"><skos:prefLabel xml:lang="es">Teniente Coronel del Aire - TC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21679"/>  <dct:created>2020-07-03 10:12:42</dct:created><dct:modified>2020-07-06 13:04:46</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21710"><skos:prefLabel xml:lang="es">Teniente de Corbeta - ST</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21700"/>  <dct:created>2020-07-06 13:06:37</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21709"><skos:prefLabel xml:lang="es">Teniente de Fragata - TE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21700"/>  <dct:created>2020-07-06 13:06:37</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21807"><skos:prefLabel xml:lang="es">Teniente de la Policía Nacional - TE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21791"/>  <dct:created>2020-07-08 10:59:54</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21708"><skos:prefLabel xml:lang="es">Teniente de Navío - CT</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21700"/>  <dct:created>2020-07-06 13:06:37</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21689"><skos:prefLabel xml:lang="es">Teniente del Aire - TE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21679"/>  <dct:created>2020-07-03 10:12:42</dct:created><dct:modified>2020-07-06 13:04:35</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capac