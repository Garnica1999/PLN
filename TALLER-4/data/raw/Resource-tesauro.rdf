bélicas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=75"/>  <dct:created>2020-02-25 16:00:28</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=467"><skos:prefLabel xml:lang="es">Acciones formativas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=461"/>  <dct:created>2020-02-26 15:37:13</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13865"><skos:prefLabel xml:lang="es">Accuracy International L96</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13816"/>  <dct:created>2020-04-30 10:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27390"><skos:prefLabel xml:lang="es">ACDI/VOCA</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-12-17 18:14:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13708"><skos:prefLabel xml:lang="es">Achagua</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13702"/>  <dct:created>2020-04-30 10:13:16</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3061"><skos:prefLabel xml:lang="es">Aco Viejo Patio Bonito</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21902"><skos:prefLabel xml:lang="es">Acompañamiento Psicosocial y Atención en Salud Mental a Víctimas de la Violencia Política - CORPORACIÓN AVRE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19798"/>  <dct:created>2020-08-14 11:03:50</dct:created><dct:modified>2020-08-28 11:43:05</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3293"><skos:prefLabel xml:lang="es">Acoso sexual</skos:prefLabel> <skos:scopeNote xml:lang="es">Es la persecución e intimidación de naturaleza sexual ejercida por alguno de los actores del conflicto armado que pone a la víctima en una situación de vulnerabilidad física y psicológica frente al actor, la cual puede incluir: contactos físicos coercitivos (manoseos), comentarios sexualmente sugerentes o agresiones verbales, sugerencias comprometedoras e incómodas, solicitud de realización de actos sexuales, intentos de violación, gestos obscenos y hasta la propagación de rumores sexuales acerca de la persona agredida.</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=421"/>  <dct:created>2020-04-24 10:55:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=456"><skos:prefLabel xml:lang="es">Actividad física, deporte y recr