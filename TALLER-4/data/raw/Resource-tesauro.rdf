s:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:39</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21794"><skos:prefLabel xml:lang="es">Comisario - CM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21793"/>  <dct:created>2020-07-08 10:57:16</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25891"><skos:prefLabel xml:lang="es">Comisión Andina de Juristas - CAJ</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=670"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-11-11 15:52:08</dct:created><dct:modified>2020-11-12 11:18:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=670"><skos:prefLabel xml:lang="es">Comisión Colombiana de Juristas - CCJ</skos:prefLabel> <skos:historyNote xml:lang="es">Esta organización abrió sus puertas en 1988, luego de que la Comisión Andina de Juristas - CAJ enviara una misión a Colombia en 1987 para elaborar un informe sobre la situación de derechos humanos y en especial sobre la administración de justicia. Inicialmente se denominó Comisión Andina de Juristas Seccional Colombiana - CAJSC, pero en 1995 simplificó su nombre por el de Comisión Colombiana de Juristas - CCJ.</skos:historyNote> <skos:historyNote xml:lang="es">Adaptado de: Comisión Colombiana de Juristas. (s.f.). Historia. https://www.coljuristas.org/quienes_somos.php?p=historia (Consultado el 12 de noviembre de 2020).</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25891"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-04-22 09:32:38</dct:created><dct:modified>2020-08-14 13:47:20</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21970"><skos:prefLabel xml:lang="es">Comisión de Ayuda al Refugiado en Euskadi - CEAR EUSKADI</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-08-14 15:11:14</dct:created><dct:modified>2020-08-28 10:56:24</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=609"><skos:prefLabel xml:lang="es">Comisión de Búsqueda de Personas Desaparecidas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-04-22 09:18:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27257"><skos:prefLabel xml:lang="es">Comisión de Conciliación Nacional - CCN</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25586"/>  <dct:created>2020-12-16 15:54:50</dct:created><dct:modified>2020-12-21 09:22:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24918"><skos:prefLabel xml:lang="es">Comisión de Interlocución del Sur de Bolívar Centro y Sur del Cesar - CISBCSC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:24:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20054"><skos:prefLabel xml:lang="es">Comisión de la Verdad Ecuador</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-06-09 14:21:34</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19828"><skos:prefLabel xml:lang="es">Comisión de la Verdad Palacio de Justicia</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-06-08 09:20:15</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25896"><skos:prefLabel xml:lang="es">Comisión de Paz Asesora del Gobierno Nacional</skos:prefLabel> <skos:historyNote xml:lang="es">Creada por el Decreto 2711 del 19 de septiembre de 1982 durante el gobierno de Belisario Betancur para prestar asistencia al presidente en el fortalecimiento de la paz pública y social, que incluía opciones de recuperación y desarrollo en las regiones, eficiencia de la administración de justicia y control del gasto público.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-