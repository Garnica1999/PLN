iondelaverdad.co/tesauro/vocab/?tema=25624"/>  <dct:created>2020-06-08 11:54:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21935"><skos:prefLabel xml:lang="es">Dirección de Derechos Humanos del Ministerio del Interior</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-08-14 14:39:17</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25934"><skos:prefLabel xml:lang="es">Dirección de Impuestos y Aduanas Nacionales - DIAN</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-11-12 11:57:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20049"><skos:prefLabel xml:lang="es">Dirección de Inteligencia Policial de la Policía Nacional - DIPOL</skos:prefLabel><skos:altLabel xml:lang="es">F2</skos:altLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19999"/>  <dct:created>2020-06-09 14:13:53</dct:created><dct:modified>2020-06-23 10:13:39</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20123"><skos:prefLabel xml:lang="es">Dirección de Investigación Criminal e Interpol - DIJÍN</skos:prefLabel><skos:altLabel xml:lang="es">División de Información, Policía Judicial y Estadística - DIPEC</skos:altLabel> <skos:historyNote xml:lang="es">Esta entidad adoptó diferentes denominaciones desde su creación en 1953. Por ejemplo, en 1971 tomó el nombre de División de Información, Policía Judicial y Estadística - DIPEC; en 1983, Dirección de Policía Judicial e Investigación DIJÍN; en 2001, Dirección Central de Policía Judicial; y, a partir de 2010, Dirección de Investigación Criminal e Interpol - DIJÍN, cuando la Organización Internacional de Policía confió a la Policía Nacional de Colombia las funciones de contribuir a nivel internacional en la lucha contra el delito.</skos:historyNote> <skos:note xml:lang="es">Adaptado de: Policía Nacional (2009). Dirección de Investigación Criminal e INTERPOL celebra sus sesenta y cuatro años de servicio a la comunidad. https://www.policia.gov.co/noticia/direccion-investigacion-criminal-e-interpol-celebra-sus-sesenta-y-cuatro-anos-servicio (Consultado el 11 de noviembre de 2020).
 </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19999"/>  <dct:created>2020-06-10 11:06:51</dct:created><dct:modified>2020-11-11 15:33:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=627"><skos:prefLabel xml:lang="es">Dirección Nacional de Inteligencia - DNI</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-04-22 09:18:40</dct:created><dct:modified>2020-06-23 09:59:24</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21989"><skos:prefLabel xml:lang="es">Dirección Nacional de Migraciones de Argentina</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-08-14 15:36:30</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27102"><skos:prefLabel xml:lang="es">Dirección para el Posconflicto y la Reconciliación de Itagüí</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=22565"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-12-10 08:59:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19865"><skos:prefLabel xml:lang="es">Dirección Seccional de Fiscalías</skos:prefLabel><skos:inScheme rdf:resource="http://capacitac