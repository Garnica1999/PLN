rdad.co/tesauro/vocab/?tema=1299"><skos:prefLabel xml:lang="es">Ondaz del Orteguaza</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:48</dct:created><dct:modified>2020-06-16 08:33:17</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25255"><skos:prefLabel xml:lang="es">ONG Labor Colombia</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19798"/>  <dct:created>2020-10-26 21:40:29</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25929"><skos:prefLabel xml:lang="es">Operación Bolívar</skos:prefLabel> <skos:historyNote xml:lang="es">Operación militar del Ejército Nacional de Colombia en el departamento del Bolívar.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3891"><skos:prefLabel xml:lang="es">Operación Fénix</skos:prefLabel> <skos:historyNote xml:lang="es">Ocurrió en marzo 1 de 2008.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-04-28 09:20:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25928"><skos:prefLabel xml:lang="es">Operación Holocausto</skos:prefLabel> <skos:historyNote xml:lang="es">Operación militar del Ejército Nacional de Colombia en la región del Catatumbo.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3894"><skos:prefLabel xml:lang="es">Operación Jaque</skos:prefLabel> <skos:historyNote xml:lang="es">Ocurrió en julio 2 de 2008.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-04-28 09:20:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3898"><skos:prefLabel xml:lang="es">Operación Odiseo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-04-28 09:20:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25933"><skos:prefLabel xml:lang="es">Operación Púrpura</skos:prefLabel> <skos:historyNote xml:lang="es">En atención a la resolución de marzo de 1999 de la Comisión de Estupefacientes de la Naciones Unidas, los países integrantes de la Comunidad Andina (Bolivia, Colombia, Ecuador, Perú y Venezuela) impulsan la Operación Púrpura. Se trata de una estrategia de operación conjunta entre las policías antidrogas de los Países Miembros de la Comunidad Andina. El objetivo está concentrado en conocer el uso del permanganato de potasio en los países en procesos industriales, y el descubrimiento de desvío de la sustancia por parte de empresas dedicadas, ya sea a la comercialización o al consumo.
En Colombia el Grupo de Operación Técnico Administrativo - GATO ejecutó acciones en el marco de la Operación Púrpura, realizando visitas a empresas entre 1999 - 2000. Este grupo fue integrado por técnicos de la Dirección Nacional de Estupefacientes - DNE, Dirección de Impuestos y Aduanas Nacionales - DIAN, Fiscalía General de la Nación - FGN, Policía Antinarcóticos y Policía Fiscal Aduanera, Policía Nacional de Colombia, Departamento Administrativo de Seguridad - DAS y Seccionales de Investigación Criminal - SIJIN.</skos:historyNote> <skos:note xml:lang="es">Adaptado de: Comunidad Andina. (2005). Panorama de los esfuerzos realizados en materia de lucha contra las drogas ilícitas y los delitos conexos en la Comunidad Andina. http://intranet.comunidadandina.org/Documentos/DInformativos/SGdi732.doc</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:47:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3897"><skos:prefLabel xml:lang="es">Operación Sodoma</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-04-28 09:20:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25930"><skos:prefLabel xml:lang="es">Operación Tsunami</skos:prefLabel> <skos:historyNote xml:lang="es">Operación militar del Ejército Nacional de Colombia.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Co