ified>2020-11-27 10:48:58</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26912"><skos:prefLabel xml:lang="es">Lengua yurutí</skos:prefLabel><skos:altLabel xml:lang="es">yurutí tapuya</skos:altLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26905"/>  <dct:created>2020-11-25 15:45:29</dct:created><dct:modified>2020-11-27 11:13:35</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26785"><skos:prefLabel xml:lang="es">Lenguas criollas</skos:prefLabel> <skos:note xml:lang="es">González, M. (s.f.). Introducción a las lenguas criollas de Colombia. En Portal de Lenguas de Colombia. https://lenguasdecolombia.caroycuervo.gov.co/contenido/Lenguas-criollas/introduccion </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26783"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26789"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26788"/>  <dct:created>2020-11-25 11:21:06</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26794"><skos:prefLabel xml:lang="es">Lenguas gitanas</skos:prefLabel> <skos:note xml:lang="es">González, M. (s.f.). Introducción a las lenguas gitanas. En Portal de Lenguas de Colombia. https://lenguasdecolombia.caroycuervo.gov.co/contenido/Lenguas-romanes-o-gitana/introduccion 
Caballero, O. (2001). Aproximación sociolingüística a la comunidad gitana rom de Colombia. Forma y Función, (14), 67 - 82. https://revistas.unal.edu.co/index.php/formayfuncion/article/view/17216</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26783"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26784"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26787"/>  <dct:created>2020-11-25 11:32:40</dct:created><dct:modified>2020-11-25 12:10:22</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26786"><skos:prefLabel xml:lang="es">Lenguas indígenas</skos:prefLabel> <skos:note xml:lang="es">González, M. (s.f.). Introducción a las lenguas indígenas de Colombia. En Portal de Lenguas de Colombia. https://lenguasdecolombia.caroycuervo.gov.co/contenido/Lenguas-indigenas/introduccion </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26783"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26797"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26798"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26799"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26800"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26801"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26802"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26804"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26803"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26805"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26806"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26807"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26808"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26809"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26810"/>  <dct:created>2020-11-25 11:21:06</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26783"><skos:prefLabel xml:lang="es">Lenguas nativas</skos:prefLabel> <skos:note xml:lang="es">Ley 1381 de 2010. Por la cual se desarrollan los artículos 7°, 8°, 10 y 70 de la Constitución Política, y los artículos 4°, 5° y 28 de la Ley 21 de 1991 (que aprueba el Convenio 169 de la OIT sobre pueblos indígenas y tribales), y se dictan normas sobre reconocimiento; fomento, protección, uso, preservación y fortalecimiento de las lenguas de los grupos étnicos de colombia y sobre sus derechos lingüísticos y los de sus hablantes. Bogotá, Colombia, 25 de enero de 2010.</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26785"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26794"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26786"/>  <dct:created>2020-11-25 11:20:23</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26810"><skos:prefLabel xml:lang="es">Lenguas sin clasificar</sko