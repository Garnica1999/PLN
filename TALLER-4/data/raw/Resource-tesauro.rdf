esauro/vocab/?tema=571"/>  <dct:created>2020-12-10 09:15:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24295"><skos:prefLabel xml:lang="es">Federación Estatal de Asociaciones de Inmigrantes y Refugiados en España - FERINE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-10-20 15:04:57</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24294"><skos:prefLabel xml:lang="es">Federación Internacional de los Derechos Humanos - FIDFH</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-10-20 15:04:57</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25890"><skos:prefLabel xml:lang="es">Federación Latinoamericana de Asociaciones de Familiares de Detenidos-Desaparecidos -  FEDEFAM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19798"/>  <dct:created>2020-11-11 15:44:14</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25020"><skos:prefLabel xml:lang="es">Federación Nacional de Cacaoteros - FEDECACAO</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:35:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25016"><skos:prefLabel xml:lang="es">Federación Nacional de Cafeteros de Colombia - FNC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:35:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25024"><skos:prefLabel xml:lang="es">Federación Nacional de Comerciantes - FENALCO</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27108"><skos:prefLabel xml:lang="es">Federación Nacional de Cooperativas Agropecuarias - FENACOA</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-10 09:15:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25023"><skos:prefLabel xml:lang="es">Federación Nacional de Cultivadores de Cereales, Leguminosas y Soya - FENALCE</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24174"><skos:prefLabel xml:lang="es">Federación Nacional de Cultivadores de Palma de Aceite - FEDEPALMA</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-08-31 18:13:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25025"><skos:prefLabel xml:lang="es">Federación Nacional de Trabajadores del Metal - FENALTRAMETAL</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=720"><skos:prefLabel xml:lang="es">Federación Nacional Sindical Unitaria Agropecuaria - FENSUAGRO</skos:prefLabel><skos:altLabel xml:lang="es">Asociación Nacional de Trabajadores Agrícolas - ANTA</skos:altLabel><skos:altLabel xml:lang="es">Federación Nacional Sindical Agraria - FENSA</skos:altLabel> <skos:historyNote xml:lang="es">La Federación Nacional Sindical Agraria - FENSA se transformó en 1984 en la Coordinadora Nacional de Organizaciones Agrarias. Luego, en 1987, la Central Unitaria de Trabajadores de Colombia - CUT impulsó un proceso unitario que reunió en un solo bloque a la Coordinadora Nacional de Organizaciones Agrarias y a la Asociación Nacional de Trabajadores Agrícolas - ANTA, para constituirse en la Federación Nacional Sindical Unitaria Agropecuaria - FENSUAGRO (García, 2019, p. 68).</skos:historyNote> <skos:note xml:lang="es">García, S. (2019). El movimiento social campesino en Colombia durante el siglo XX. Un panorama amplio de su organización, demandas y repertorios de acción. [Tesis de pregrado, Universidad de Antioquia]. http://bibliotecadigital.udea.edu.co/bitstream/10495/14617/1/GarciaSantiago_2019_MovimientoSocialCampesino.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-04-22 09:32:39</dct:created><dct:modified>2020-08-14 13:55:12</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25021"><skos:prefLabel xml:lang="es">Federación Red de Mujeres de Yumbo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25028"><skos:prefLabel xml:lang="es">Federación Regional de Productores de Carbón del Norte de Santander - FEREPROCARBÓN</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27106"><skos:prefLabel xml:lang="es">Federación Sindical de Trabajadores Agrarios de Colombia - FESTRACOL</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-12-10 09:07:25</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25022"><skos:prefLabel xml:lang="es">Federación Sindical Unitaria de Trabajadores de Córdoba - FESTRACOR</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25647"/>  <dct:created>2020-10-20 17:36:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25201"><skos:prefLabel xml:lang="es">Federación Unitaria de Trabajadores de Antioquia - FUTRAN</skos:prefLabel><skos:altLabel xml:lang="es">Federación Sindical Unitaria de Trabajadores de Antioquia - FESUTRAN</skos:altLabel> <skos:historyNote xml:lang="es">En 1993, La Federación Sindical Unitaria de Trabajadores de Antioquia (FESUTRAN) se fusionó con otras organizaciones para crear la Federación Unitaria de Trabajadores de Antiquia (FUTRAN).</skos:historyNote> <skos:note xml:lang="es">Castaño, E. (2015). Nos hacen falta: Memoria histórica de la violencia antisindical en Antioquia, Atlántico y Santander (1975- 2012). Ediciones Escuela Nacional Sindical. https://verdadabierta.com/audios/2015/noviembre/informe-nos-hacen-falta.pdf </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/>  <dct:created>2020-10-26 21:16:21</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25046"><skos:prefLabel xml:lang="es">Federación Universitaria Nacional - FUN COMISIONES MODEP</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-10-20 17:37:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21836"><skos:prefLabel xml:lang="es">Femenino</skos:prefLabel> <skos:note xml:lang="es">Secretaría Distrital de Gobierno. (s.f.). Glosario. Consultado el 15 de julio de http://www.gobiernobogota.gov.co/transparencia/informacion-interes/glosario</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:related rdf:resource="http://capacitacion.comisiondelaverdad.co/tes