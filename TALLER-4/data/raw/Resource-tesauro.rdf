2. Organización Mundial de la Salud - OMS. (s.f.). Género y salud. Definiciones. https://www.who.int/es/news-room/fact-sheets/detail/gender (Consultado el 23 de noviembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21819"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21820"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21822"/>  <dct:created>2020-07-21 15:10:53</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21828"><skos:prefLabel xml:lang="es">Género fluido</skos:prefLabel> <skos:note xml:lang="es">National Geographic en Español. (s.f.). El glosario del género. Consultado el 15 de julio de https://www.ngenespanol.com/el-mundo/identidad-sexual-y-de-genero-definicion-de-identidad-de-genero/</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21819"/>  <dct:created>2020-07-21 15:25:13</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=404"><skos:prefLabel xml:lang="es">Genocidio</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=367"/>  <dct:created>2020-02-26 15:19:52</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1710"><skos:prefLabel xml:lang="es">Genova Estéreo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro