reated>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26176"><skos:prefLabel xml:lang="es">Cultivador de pino</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:25:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=159"><skos:prefLabel xml:lang="es">Cultivos de uso ilícito</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=158"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=167"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=166"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=168"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=165"/>  <dct:created>2020-02-25 16:17:39</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=224"><skos:prefLabel xml:lang="es">Culturales</skos:prefLabel> <skos:historyNote xml:lang="es">Impactos, daños o afectaciones sobre las cosmovisiones y la capacidad para la reproducción cultural, y sobre la conservación y trasmisión intergeneracional de conocimientos ancestrales (Ej.: rituales y ceremonias; sitios sagrados; el idioma propio; la transmisión del conocimiento; el ejercicio y la reproducción de la salud y la educación propias; el conocimiento reservado; el conocimiento y las prácticas médicas; los sistemas de producción, distribución, autoabastecimiento, consumo, intercambio y comercialización; los roles de trabajo; los usos alimentarios cotidianos y rituales; el patrimonio cultural; los patrones estéticos; y las estrategias y redes comunicacionales, entre otros.)</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=197"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=23840"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=23838"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=23839"/>  <dct:created>2020-02-26 11:02:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21871"><skos:prefLabel xml:lang="es">Culturas urbanas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13701"/>  <dct:created>2020-07-21 16:59:23</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2585"><skos:prefLabel xml:lang="es">Cumaral, Guamuco</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created><dct:modified>2020-06-15 16:26:06</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2642"><skos:prefLabel xml:lang="es">Cumbal</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelave