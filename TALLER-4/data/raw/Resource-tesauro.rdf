abel xml:lang="es">Cambio cultural</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=244"/>  <dct:created>2020-02-26 11:23:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=276"><skos:prefLabel xml:lang="es">Cambio identitario</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=244"/>  <dct:created>2020-02-26 11:23:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=330"><skos:prefLabel xml:lang="es">Cambios económicos y materiales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=308"/>  <dct:created>2020-02-26 11:53:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=117"><skos:prefLabel xml:lang="es">Cambios en el uso del suelo y tenencia de la tierra</skos:prefLabel> <skos:scopeNote xml:lang="es">Cambios en actividades productivas que determinan la utilización que le se da a la tierra, por ejemplo, al pasar de bosques de conservación a ganadería, de ganadería a monocultivos, etc. Cuando se relatan compras masivas de predios o el predominio de contratos de arrendamiento o de otras figuras, esto también puede estar asociado a cambios en la tenencia de la tierra.</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=114"/>  <dct:created>2020-02-25 16:04:47</dct:created>  </skos:Concept>  <skos:Conc