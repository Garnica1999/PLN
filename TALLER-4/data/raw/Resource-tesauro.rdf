skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27366"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27334"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27378"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19863"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25669"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27240"/>  <dct:created>2020-11-04 16:22:22</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25927"><skos:prefLabel xml:lang="es">Conferencias Nacionales Guerrilleras de las FARC-EP</skos:prefLabel> <skos:historyNote xml:lang="es">Espacios de decisión política, ideológica y militar de las FARC-EP donde se tomaban decisiones sobre Reglamentos, Estatutos, Normas de Comando y lineamientos del Plan Estratégico, que dictaban todo su actuar como grupo armado a nivel nacional y territorial. En total fueron diez Conferencias realizadas entre 1965 y 2016.</skos:historyNote> <skos:note xml:lang="es">FARC-EP. (s.f.). ¿Qué es la Conferencia Nacional de Guerrilleros? https://www.farc-ep.co/octava-conferencia/que-es-la-conferencia-nacional-de-guerrilleros.html (Consultado el 22 de septiembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25940"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25946"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25945"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25944"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25937"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25941"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25938"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25943"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25942"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25939"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19837"><skos:prefLabel xml:lang="es">Confidencial Colombia</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=828"/>  <dct:created>2020-06-08 10:05:49</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=375"><skos:prefLabel xml:lang="es">Confinamiento</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=363"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=444"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=443"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=442"/>  <dct:created>2020-02-26 15:00:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=444"><skos:prefLabel xml:lang="es">Confinamiento colectivo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=375"/>  <dct:created>2020-02-26 15:26:26</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=184"><skos:prefLabel xml:lang="es">Confinamiento de pueblos étnicos</skos:prefLabel> <skos:note xml:lang="es">Corte Constitucional (2009). Auto N.º 005 de 2009: “Protección de los derechos fundamentales de la población afrodescendiente víctima del desplazamiento forzado, en el marco del estado de cosas inconstitucional declarado en la sentencia T-025 de 2004”. Bogotá, D. C.: Imprenta Nacional de Colombia.</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=181"/>  <dct:created>2020-02-26 10:58:25</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=443"><skos:prefLabel xml:lang="es">Confinamiento familiar</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=375"/>  <dct:created>2020-02-26 15:26:26</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=442"><skos:prefLabel xml:lang="es">Confinamiento individual</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=375"/>  <dct:created>2020-02-26 15:26:26</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=39"><skos:prefLabel xml:lang="es">Conflicto por acceso a servicios públicos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"/>  <dct:created>2020-02-25 15:05:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=38"><skos:prefLabel xml:lang="es">Conflictos entre patrones y trabajadores</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"/>  <dct:created>2020-02-25 15:05:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=221"><skos:prefLabel xml:lang="es">Conflictos interétnicos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=194"/>  <dct:created>2020-02-26 11:01:52</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=40"><skos:prefLabel xml:lang="es">Conflictos por la defensa de DD. HH. - DIH</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"/>  <dct:created>2020-02-25 15:05:03</dct:created><dct:modified>2020-10-28 20:31:28</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=118"><skos:prefLabel xml:lang="es">Conflictos por la tierra</skos:prefLabel> <skos:scopeNote xml:lang="es">Conflictos por la ocupación, tenencia, propiedad, titulación y uso de tierras. Puede incluir actores como comunidades campesinas, pueblos étnicos, ganaderos, terratenientes, empresarios agroindustriales, del sector minero-energético, el Estado u otros.</skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=114"/>  <dct:created>2020-02-25 16:04:47</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=43"><skos:prefLabel xml:lang="es">Conflictos por los procesos de representación política</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"/>  <dct:created>2020-02-25 15:05:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=44"><skos:prefLabel xml:lang="es">Conflictos respecto a la resolución de la guerra</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=36"/>  <dct:created>2020-02-25 15:05:03</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27260"><skos:prefLabel xml:lang="es">Confraternidad Carcelaria de Colombia - CCC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-12-16 16:09:30</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25590"><skos:prefLabel xml:lang="es">Congregación de Misioneras de la Madre Laura</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25586"/>  <dct:created>2020-11-04 15:56:30</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25591"><skos:prefLabel xml:lang="es">Congregación de Religiosas Hijas de Cristo Rey</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25586"/>  <dct:created>2020-11-04 15:56:30</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25592"><skos:prefLabel xml:lang="es">Congregación Hermanas Franciscanas Misioneras de María Auxiliadora</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25586"/>  <dct:created>2020-11-04 15:56:30</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26550"><skos:prefLabel xml:lang="es">Congresista</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13626"/>  <dct:created>2020-11-13 18:19:33</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=616"><skos:prefLabel xml:lang="es">Congreso de la República</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-04-22 09:18:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20060"><skos:prefLabel xml:lang="es">Congreso Visible</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20022"/>  <dct:created>2020-06-09 14:29:32</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1711"><skos:prefLabel xml:lang="es">Consacá Estéreo 90.1 FM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:50</dct:created><dct:modified>2020-06-08 11:04:28</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2691"><skos:prefLabel xml:lang="es">Consara-Mecaya</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19838"><skos:prefLabel xml:lang="es">Consejería Presidencial para la Defensa, Protección y Promoción de los Derechos Humanos</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-06-08 10:07:06</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19839"><skos:prefLabel xml:lang="es">Consejería Presidencial para los Derechos Humanos y Asuntos Internacionales</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-06-08 10:07:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27527"><skos:prefLabel xml:lang="es">Consejería Presidencial para Medellín y el Área Metropolitana</skos:prefLabel> <skos:historyNote xml:lang="es">«En 1990, el gobierno del presidente César Gaviria Trujillo creó la Consejería Presidencial para Medellín y el Área Metropolitana, con el propósito de ofrecerles oportunidades a sus habitantes, en especial a los jóvenes que vivían en condiciones de vulnerabilidad social en las comunas nororiental y noroccidental, en donde el sicariato y el trabajo para los carteles de la droga era la forma más viable y fácil de ganarse la vida. La Consejería se enfocó en crear parques, canchas, salones comunales y programas sociales que restablecieran la ciudadanía y la unión en esos territorios en los que solo se hablaba de Pablo Escobar, la violencia, el dinero fácil y los carrosbomba».
</skos:historyNote> <skos:note xml:lang="es">Medellín abraza su historia. (s.f.). Creación de la Consejería Presidencial para Medellín. https://www.medellinabrazasuhistoria.com/creacion-de-la-consejeria-presidencial-para-medellin/ (Consultado el 7 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-18 10:54:17</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26138"><skos:prefLabel xml:lang="es">Consejero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13632"><skos:prefLabel xml:lang="es">Consejero Comercial</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13626"/>  <dct:created>2020-04-30 10:05:42</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26139"><skos:prefLabel xml:lang="es">Consejero jurídico</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2262"><skos:prefLabel xml:lang="es">Consejo Comunitario 
 de La Gran Unión del Río Telpí</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=575"/>  <dct:created>2020-04-22 10:45:22</dct:created><dct:modified>2020-07-08 11:39:08</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25902"><skos:prefLabel xml:lang="es">Consejo Comunitario Aires de Garrapatero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=575"/>  <dct:created>2020-11-11 17:21:52</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2269"><skos:prefLabel xml:lang="es">Consejo Comunitario Alejandro Rincon del Río Ñambì</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=575"/>  <dct:created>2020-04-22 10:45:22</dct:created><dct:modified>2020-06-12 07:33:09</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2124"><skos:prefLabel xml:lang="es">Consejo Comunitario Alto Guapi</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=575"/>  <dct:created>2020-04-22 10:45:21</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2258"><skos:prefLabel xml:lang="es">Consejo Comunitario Alto Mira y Frontera</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacita