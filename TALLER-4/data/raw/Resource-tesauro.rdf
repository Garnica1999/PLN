l xml:lang="es">Consejos Municipales de Desarrollo Rural - CMDR</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-12-09 09:18:15</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27261"><skos:prefLabel xml:lang="es">Consejos Regionales de Paz</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27265"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27267"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27262"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27263"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27264"/>  <dct:created>2020-12-16 16:24:37</dct:created><dct:modified>2020-12-16 16:26:47</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27056"><skos:prefLabel xml:lang="es">Consejos Seccionales de Desarrollo Agropecuario, Pesquero, Forestal Comercial y de Desarrollo Rural - CONSEA</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-12-09 09:12:17</dct:created><dct:modified>2020-12-09 09:12:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=24313"><skos:prefLabel xml:lang="es">Consejos Territoriales de Planeación - CTP</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=570"/>  <dct:created>2020-10-20 15:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26140"><skos:prefLabel xml:lang="es">Conserje</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=22016"><skos:prefLabel xml:lang="es">Constituyente de Exiliados/as Políticos Perseguidos por el Estado Colombiano</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-08-18 12:15:19</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27063"><skos:prefLabel xml:lang="es">Constituyente de Nariño por un Mandato Popular</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26984"/>  <dct:created>2020-12-09 09:20:37</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27064"><skos:prefLabel xml:lang="es">Constituyente Social de Valle del Cauca</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26984"/>  <dct:created>2020-12-09 09:20:37</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=473"><skos:prefLabel xml:lang="es">Construcción de paz</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=461"/>  <dct:created>2020-02-26 15:37:13</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=482"><skos:prefLabel xml:lang="es">Construcción del enemigo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=479"/>  <dct:created>2020-02-26 15:39:45</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26141"><skos:prefLabel xml:lang="es">Constructor</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26142"><skos:prefLabel xml:lang="es">Constructor de maquinaria</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21937"><skos:prefLabel xml:lang="es">Consulado de Colombia en Ecuador</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=20001"/>  <dct:created>2020-08-14 14:41:21</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27084"><skos:prefLabel xml:lang="es">Consulta Popular de Aguachica</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 1995 en Aguachica (Cesar) para rechazar la violencia y convertir el municipio en modelo de paz. </skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created><dct:modified>2020-12-09 11:25:53</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27066"><skos:prefLabel xml:lang="es">Consulta Popular de Arbeláez</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Arbeláez (Cundinamarca) sobre la ejecución de actividades de sísmica, exploración, explotación y lavado de hidrocarburos y/o minería a gran escala en el municipio. </skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27067"><skos:prefLabel xml:lang="es">Consulta Popular de Cabrera</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Cabrera (Cundinamarca) sobre la ejecución de proyectos hidroeléctricos y/o mineros en el municipio. </skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27085"><skos:prefLabel xml:lang="es">Consulta Popular de Caicedo</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2007 para proclamar a Caicedo como el primer municipio no violento del departamento de Antioquia.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27069"><skos:prefLabel xml:lang="es">Consulta Popular de Cajamarca</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Cajamarca (Tolima) sobre la ejecución de proyectos y actividades mineras.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27068"><skos:prefLabel xml:lang="es">Consulta Popular de Cumaral</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Cumaral (Meta) sobre la exploración, perforación y producción de hidrocarburos en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27086"><skos:prefLabel xml:lang="es">Consulta Popular de Fonseca</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 1999 en Fonseca (La Guajira) para rechazar que la población civil siguiera involucrada en la guerra y convertir el municipio en un modelo de convivencia pacífica.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27082"><skos:prefLabel xml:lang="es">Consulta Popular de Fusagasugá</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2018 en Fusagasugá (Cundinamarca) sobre la ejecución de actividades de exploración sísmica, perforación exploratoria, fracking, producción de hidrocarburos y minería a gran escala en el municipio. </skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27083"><skos:prefLabel xml:lang="es">Consulta Popular de Jesús María</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Jesús María (Santander) sobre la ejecución de actividades de exploración minera y petrolera en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27071"><skos:prefLabel xml:lang="es">Consulta Popular de Mercaderes</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27072"><skos:prefLabel xml:lang="es">Consulta Popular de Monterrey</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2014 en Monterrey (Casanare) sobre la ejecución de actividades de exploración sísmica, perforación exploratoria, producción y transporte de hidrocarburos.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27073"><skos:prefLabel xml:lang="es">Consulta Popular de Piedras</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2013 en Piedras (Tolima) sobre la ejecución de actividades de exploración, explotación, tratamiento, transformación, transporte, lavado de materiales, provenientes de las actividades de explotación minera aurífera a gran escala en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27090"><skos:prefLabel xml:lang="es">Consulta Popular de Pijao</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Pijao (Quindío) sobre la ejecución de proyectos y actividades de minería de metales en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:37:14</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27087"><skos:prefLabel xml:lang="es">Consulta Popular de San Juan del Cesar</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 1999 en San Juan del Cesar (La Guajira) para rechazar que la población civil siguiera involucrada en la guerra y convertir el municipio en un modelo de convivencia pacífica.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27088"><skos:prefLabel xml:lang="es">Consulta Popular de Santa Marta</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 1995 en Santa Marta (Magdalena) para convertir el distrito en modelo nacional de paz y para preservar la Sierra Nevada de Santa Marta como patrimonio común de la humanidad.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:32:58</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27091"><skos:prefLabel xml:lang="es">Consulta Popular de Sucre</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2017 en Sucre (Santander) sobre la ejecución de actividades de exploración y explotación minera y petrolera en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:37:14</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27074"><skos:prefLabel xml:lang="es">Consulta Popular de Tauramena</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 2013 en Tauramena (Casanare) sobre la exploración sísmica, perforación exploratoria, producción y transporte de hidrocarburos en el municipio.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:22:24</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27089"><skos:prefLabel xml:lang="es">Consulta Popular de Villanueva</skos:prefLabel> <skos:historyNote xml:lang="es">Consulta realizada en 1999 en Villanueva (La Guajira) para rechazar que la población civil siguiera involucrada en la guerra y convertir el municipio en un modelo de convivencia pacífica.</skos:historyNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"/>  <dct:created>2020-12-09 09:37:14</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=209"><skos:prefLabel xml:lang="es">Consulta previa</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=191"/>  <dct:created>2020-02-26 11:00:27</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27065"><skos:prefLabel xml:lang="es">Consultas Populares</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25458"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27084"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27066"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27067"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27085"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27069"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27068"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27086"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27082"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27083"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27071"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27072"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27073"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27090"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27087"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27088"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27091"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27074"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27089"/>  <dct:created>2020-12-09 09:21:37</dct:created><dct:modified>2020-12-09 09:21:50</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26143"><skos:prefLabel xml:lang="es">Consultor</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26144"><skos:prefLabel xml:lang="es">Consultora de belleza</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=671"><skos:prefLabel xml:lang="es">Consultoría para los Derechos Humanos y el Desplazamiento - CODHES</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-04-22 09:32:38</dct:created><dct:modified>2020-08-14 13:48:33</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=162"><skos:prefLabel xml:lang="es">Consumo de drogas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=158"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=176"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=177"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=175"/>  <dct:created>2020-02-25 16:17:39</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1334"><skos:prefLabel xml:lang="es">Contacto Stereo 99.4 FM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:48</dct:created><dct:modified>2020-06-08 11:04:37</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13633"><skos:prefLabel xml:lang="es">Contador General de la Nación</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13626"/>  <dct:created>2020-04-30 10:05:42</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26145"><skos:prefLabel xml:lang="es">Contador público</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 17:21:20</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=19842"><skos:prefLabel xml:lang="es">Contagio Radio</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-06-08 10:19:57</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=70"><skos:prefLabel xml:lang="es">Contexto de vida previo a la vinculación de combatientes</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="h