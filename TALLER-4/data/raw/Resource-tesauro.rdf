cept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13841"><skos:prefLabel xml:lang="es">Pistola cordova</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13827"/>  <dct:created>2020-04-30 10:20:12</dct:created><dct:modified>2020-04-30 12:21:52</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13844"><skos:prefLabel xml:lang="es">Pistola Glock 17</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13827"/>  <dct:created>2020-04-30 10:20:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13843"><skos:prefLabel xml:lang="es">Pistola IMI/IWI Jericó 941 y 941 TF</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=13827"/>  <dct:created>2020-04-30 10:20:12</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2464"><skos:prefLabel xml:lang="es">Pitayó</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:40</dct:created><dct:modified>2020-10-01 06:43:13</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3637"><skos:prefLabel xml:lang="es">Pivijay, Tomás Guillén o el Grupo de Rafa</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3555"/>  <dct:created>2020-04-27 17:12:01</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26471"><skos:prefLabel xml:lang="es">Pizzero</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 18:06:00</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25931"><skos:prefLabel xml:lang="es">Plan Colombia</skos:prefLabel> <skos:historyNote xml:lang="es">Estrategia integral de cooperación bilateral entre Colombia y Estados Unidos, cuyo objetivo general es combatir las drogas ilícitas y el crimen organizado, para así contribuir a la reactivación económica y la consecución de la paz en Colombia, al tiempo que se fortalece el control sobre la oferta de drogas ilícitas en Estados Unidos. Se creó en 1999 y fue cambiando de objetivos estratégicos, hasta ser reemplazado en 2016 por el programa Paz Colombia, ejecutado entre el gobierno de Juan Manual Santos y Barack Obama. </skos:historyNote> <skos:note xml:lang="es">Departamento Nacional de Planeación. (2006). Balance Plan Colombia 1999 - 2005. 
https://colaboracion.dnp.gov.co/cdt/justicia%20seguridad%20y%20gobierno/bal_plan_col_espanol_final.pdf (Consultado el 22 de septiembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27156"><skos:prefLabel xml:lang="es">Plan de Desarrollo Tocaima - Municipio Saludable con Gestión Participativa</skos:prefLabel> <skos:note xml:lang="es">Adaptado de: Enciso, F. (13 de octubre de 2001). Tocaima, ciudad salud de Colombia. El Tiempo. https://www.eltiempo.com/archivo/documento/MAM-701561 (Consultaado el 10 de diciembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 11:53:49</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25641"><skos:prefLabel xml:lang="es">Plan Integral de Reparación Colectiva - PIRC</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-11-04 17:17:35</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25932"><skos:prefLabel xml:lang="es">Plan Patriota</skos:prefLabel> <skos:historyNote xml:lang="es">Plan militar desarrollado durante el mandato de Álvaro Uribe Vélez como parte de su Política de Seguridad Democrática, con el apoyo financiero de Estados Unidos. Su objetivo principal fue combatir a los grupos guerrilleros de las Fuerzas Armadas Revolucionarias de Colombia - FARC-EP y el Ejército de Liberación Nacional - ELN, así como lograr presencia militar en zonas alejadas. Estuvo estructurado en tres fases: Alistamiento y despliegue, Debilitamiento y Consolidación. El plan inició en 2002 y terminó en 2007.</skos:historyNote> <skos:note xml:lang="es">Adaptado de: Mora, J. (s.f.). El Plan Patriota: plan para la conducción conjunta de la guerra irregular. https://publicacionesejercito.mil.co/recurso_user/revista_ejercito/Revista_191/el-plan-patriota-plan-para-la-conduccion-conjunta-de-la-guerra-irregular.html (Consultado el 22 de septiembre de 2020). </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3862"/>  <dct:created>2020-11-12 10:34:55</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=3006"><skos:prefLabel xml:lang="es">Planadas Telembí</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:43</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27543"><skos:prefLabel xml:lang="es">Planes de Vida, Ambientes de Paz y Calidad Educativa</skos:prefLabel> <skos:note xml:lang="es">Sánchez, N. (15 de diciembre de 2016). Premio a la paz que se construye desde colegios. El Espectador. https://www.elespectador.com/colombia2020/pais/premio-la-paz-que-se-construye-desde-los-colegios-articulo-855017/ </skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-19 09:54:44</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1341"><skos:prefLabel xml:lang="es">Planeta Fm</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:48</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25677"><skos:prefLabel xml:lang="es">Plataforma Ciudadana Hijos de Nelson Mandela</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-11-05 14:12:46</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25674"><skos:prefLabel xml:lang="es">Plataforma Ciudadana Hijos del Magdalena</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-11-05 14:12:46</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25676"><skos:prefLabel xml:lang="es">Plataforma de Incidencia Política de las Mujeres Rurales Colombianas</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=571"/>  <dct:created>2020-11-05 14:12:46</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=22019"><skos:prefLabel xml:lang="es">Plataforma Extremeña de Solidaridad con Colombia</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource=