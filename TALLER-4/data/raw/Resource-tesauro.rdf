a</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26397"><skos:prefLabel xml:lang="es">Matemático</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 18:00:11</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=425"><skos:prefLabel xml:lang="es">Maternidad o crianza forzada</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=421"/>  <dct:created>2020-02-26 15:23:51</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2382"><skos:prefLabel xml:lang="es">Maticurú</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:40</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=1623"><skos:prefLabel xml:lang="es">Máxima Stéreo 98.8 FM</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=830"/>  <dct:created>2020-04-22 10:38:49</dct:created><dct:modified>2020-06-16 08:03:21</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2615"><skos:prefLabel xml:lang="es">Mayabangloma</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=2643"><skos:prefLabel xml:lang="es">Mayasquer</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=576"/>  <dct:created>2020-04-22 10:51:41</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=27145"><skos:prefLabel xml:lang="es">Mayo por la Vida</skos:prefLabel> <skos:note xml:lang="es">Medellín. (4 de mayo de 2015). 'Mayo por la vida', iniciativa para la 'No violencia' en Medellín. El Tiempo. https://www.eltiempo.com/archivo/documento/CMS-15687635 (Consultado el 10 de diciembre de 2020).</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=25627"/>  <dct:created>2020-12-10 11:09:05</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21716"><skos:prefLabel xml:lang="es">Mayor - MY</skos:prefLabel> <skos:scopeNote xml:lang="es">"El rango militar de mayor o comandante es el inmediatamente inferior al de teniente coronel e inmediatamente superior al de capitán. Por lo general se desempeña como jefe de un batallón. También se ocupa de algunas de las secciones del personal o adiestramiento dentro de un batallón o en algunos casos, un regimiento. En la marina de guerra es el grado equivalente a capitán de corbeta. [...] El rango de mayor es el primer grado de los oficiales superiores de la Fuerza Pública de Colombia. Su tiempo mínimo en el grado es de cinco años y acceden a él los capitanes. Para seguir al grado siguiente, es decir, al de teniente coronel, deben los oficiales aprobar un curso de Estado Mayor". [Mayor. (23 de julio de 2020). En Wikipedia. https://es.wikipedia.org/wiki/Mayor#Colombia]
 </skos:scopeNote><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21696"/>  <dct:created>2020-07-06 13:09:27</dct:created><dct:modified>2020-07-23 17:04:11</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21805"><skos:prefLabel xml:lang="es">Mayor de la Policía Nacional - MY</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21791"/>  <dct:created>2020-07-08 10:59:54</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21687"><skos:prefLabel xml:lang="es">Mayor del Aire - MY</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21679"/>  <dct:created>2020-07-03 10:12:42</dct:created><dct:modified>2020-07-06 13:04:16</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21683"><skos:prefLabel xml:lang="es">Mayor General  del Aire - MG</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21679"/>  <dct:created>2020-07-03 10:12:42</dct:created><dct:modified>2020-07-06 13:02:50</dct:modified>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21711"><skos:prefLabel xml:lang="es">Mayor General - MG</skos:prefLabel> <skos:note xml:lang="es">"En los departamentos, apostaderos y escuadras, jefe que desempeña funciones semejantes a las del Estado Mayor en el Ejército". [Real Academia Española. (2018). Mayor. En Diccionario de la lengua española (edición tricentenario). Consultado el 23 de julio de 2020. https://dle.rae.es/mayor?m=form]</skos:note><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21693"/>  <dct:created>2020-07-06 13:07:19</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21801"><skos:prefLabel xml:lang="es">Mayor General de la Policía Nacional - MG</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=21791"/>  <dct:created>2020-07-08 10:59:54</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26398"><skos:prefLabel xml:lang="es">Mayordomo</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/>  <dct:created>2020-11-13 18:00:11</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26399"><skos:prefLabel xml:lang="es">Mecánico</skos:prefLabel><skos:inScheme rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/"/><skos:broader rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=4040"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26400"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26401"/><skos:narrower rdf:resource="http://capacitacion.comisiondelaverdad.co/tesauro/vocab/?tema=26402"/>  <dct:created>2020-11-13 18:00:31</dct:created>  </skos:Concept>  <skos:Concept rdf:about="http://capacitac