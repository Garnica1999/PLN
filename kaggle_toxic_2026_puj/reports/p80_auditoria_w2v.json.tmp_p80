  "correccion_de_p79": {
    "principio": "P80 no edita P79 ni su informe. La correccion va en un documento nuevo, y ninguna de las tres correcciones cambia los hallazgos de H1 que P79 si acerto",
    "correcciones": [
      {
        "afirmacion_de_P79": "lectura de las semillas del scheduler: semillas_desalineadas = false, con una unica lista entrenamiento = [0, 1, 2, 3, 4, 5]",
        "por_que_mal": "su heuristica metio los dos bucles en el mismo grupo, y el booleano salia False no porque los rangos coincidieran, sino porque solo habia un grupo. Su propia lista tiene 6 elementos para EPOCAS = 5, y eso ya lo contradicia",
        "veredicto_real": "A7: CONFIRMADO",
        "lo_que_dice_P80": "los dos bucles usan rangos distintos, leidos por AST con mapa de padres, sin buscar hacia atras un encabezado ni etiquetar por una ventana de cadena"
      },
      {
        "afirmacion_de_P79": "la_identidad_se_cumple = false en los cuatro valores de K",
        "por_que_mal": "comparaba pos + neg_codigo contra l_codigo, que es -(pos + neg_codigo): faltaba el signo menos. Y el script no paraba, con lo que un indicador que siempre falla no informa de nada",
        "veredicto_real": "A9: CONFIRMADO",
        "lo_que_dice_P80": "la identidad se afirma con el signo correcto y con parada, y ademas se comprueba que la identidad mal puesta falla, para que la asercion tenga poder discriminante"
      },
      {
        "afirmacion_de_P79": "punto_5_artefacto_congelado, que mide loss y normas de gradiente sobre el artefacto",
        "por_que_mal": "asigno E = S = W, la misma matriz guardada, a la tabla de entrada y a la de salida. El artefacto solo guarda W",
        "veredicto_real": "A13: NO APLICABLE POR CONSTRUCCION",
        "lo_que_dice_P80": "no se mide el artefacto entrenado porque no se puede: se declara el limite y la afirmacion queda NO APLICABLE POR CONSTRUCCION, sin sustituir la tabla que falta por W"
      }
    ]
  },
