MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=rag_full_bge_m3_d1024_v1
EMBEDDER=bge
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMS=1024
EMBEDDINGS_BATCH=32
EMBEDDING_DEVICE=cuda
EMBEDDING_HALF=true
SPARSE_COLLECTION=rag_full_bge_m3_d1024_bm25_v1
OLLAMA_URL=http://localhost:11435
LLM_MODEL=gemma4:e4b
JUDGE_MODEL=llama3.2:3b
MAX_CONTEXT_TOKENS=16384
MAX_OUTPUT_TOKENS=8192
GEMMA4_INPUT_TOKENS=16384
GEMMA4_OUTPUT_TOKENS=100000
REASONING_TOKENS=1024
TOP_K=5
MIN_SCORE=0.0
RETRIEVER=dense
RERANK=1
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_TOP_N=0
RERANK_SCORE_RATIO=0.0
DOMAIN_CLASSIFIER_PATH=modelos/domain_classifier.json
DOMAIN_THRESHOLD=0.5
SEARCH_EF=800
HYBRID_DENSE=0.5
HYBRID_SPARSE=0.5
PARQUET_PATH=/work/data/documentos_rag.parquet
REQUEST_TIMEOUT=240

