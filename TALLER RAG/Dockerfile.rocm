FROM rocm/pytorch:rocm7.2.4_ubuntu24.04_py3.12_pytorch_release_2.10.0

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/work

WORKDIR /work

RUN pip install --no-cache-dir \
    "pymilvus>=2.6,<2.7" \
    "pandas>=2.2,<3" \
    "pyarrow>=17" \
    "sentence-transformers>=3,<6" \
    "fastapi>=0.115,<1" \
    "uvicorn[standard]>=0.30,<1" \
    "requests>=2.32,<3" \
    "pydantic>=2.8,<3" \
    "langchain-core>=0.3,<1" \
    "langchain-ollama>=0.3,<1" \
    "openpyxl>=3.1,<4" \
    "scikit-learn>=1.4,<2"

COPY src ./src
